#!/bin/sh
set -e
CONF=/etc/mtg-cards/server.json

if [ "$1" = "configure" ]; then
    if ! getent passwd mtgcards >/dev/null; then
        useradd --system --user-group --home-dir /var/lib/mtg-cards --no-create-home \
            --shell /usr/sbin/nologin --comment "MTG Cards Server" mtgcards
    fi
    install -d -o mtgcards -g mtgcards -m 0750 /var/lib/mtg-cards
    install -d -o root -g mtgcards -m 0750 /etc/mtg-cards
    if [ ! -f "$CONF" ]; then
        /usr/bin/mtg-cards-server --config "$CONF" --show-token >/dev/null
    fi
    chown root:mtgcards "$CONF"
    chmod 0640 "$CONF"

    # Ab Version 3: Proxie Maker ist Teil von MTG Cards – Daten des früheren Einzel-Servers einmalig übernehmen
    OLD_PM=/var/lib/proxie-maker/proxies.db
    NEW_PM=/var/lib/mtg-cards/proxies.db
    if [ -f "$OLD_PM" ] && [ ! -f "$NEW_PM" ]; then
        python3 -c "import sqlite3,sys;s=sqlite3.connect(sys.argv[1]);d=sqlite3.connect(sys.argv[2]);s.backup(d);d.close()" \
            "$OLD_PM" "$NEW_PM" && chown mtgcards:mtgcards "$NEW_PM" && chmod 0640 "$NEW_PM" \
            && echo "  Proxie-Maker-Daten übernommen ($OLD_PM -> $NEW_PM)."
    fi
    if [ -d /run/systemd/system ] && systemctl is-enabled proxie-maker-server.service >/dev/null 2>&1; then
        systemctl disable --now proxie-maker-server.service >/dev/null 2>&1 || true
        echo "  Der frühere Dienst proxie-maker-server wurde beendet (jetzt Teil von MTG Cards)."
        echo "  Paket entfernen (Daten bleiben erhalten):  sudo apt remove proxie-maker-server"
    fi

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable mtg-cards-server.service >/dev/null 2>&1 || true
        systemctl restart mtg-cards-server.service || true
    fi

    TOKEN=$(/usr/bin/mtg-cards-server --config "$CONF" --show-token 2>/dev/null || true)
    echo ""
    echo "  MTG Cards Server installiert und gestartet (Port 8765)."
    echo "  Zugangs-Token für App und Desktop:  $TOKEN"
    echo "  Token später anzeigen:  sudo mtg-cards-server --show-token"
    echo "  Weboberfläche:          http://<server-ip>:8765   (Proxie Maker: http://<server-ip>:8765/proxies/)"
    echo ""
fi
exit 0
