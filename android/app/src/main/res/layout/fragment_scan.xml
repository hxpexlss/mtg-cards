<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <de.mtgcards.scanner.GuideOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_status"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Karte in den Rahmen halten"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnTorch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_status"
            android:contentDescription="Licht"
            android:src="@drawable/ic_flash" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_status"
            android:contentDescription="Scan-Einstellungen"
            android:src="@drawable/ic_menu_white" />
    </LinearLayout>

    <TextView
        android:id="@+id/modeInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="66dp"
        android:background="@drawable/bg_status"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="#FFD27A"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/pending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_status"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="#FFD27A"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sessionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_status"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnBatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnManual"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name eingeben" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/resImage"
                    android:layout_width="96dp"
                    android:layout_height="134dp"
                    android:contentDescription="Kartenbild"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/resName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/resInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/resTags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/gold"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/resOwned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMinus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="−" />

                <TextView
                    android:id="@+id/qty"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="+" />

                <CheckBox
                    android:id="@+id/foil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Foil" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPrint"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Druck ändern" />

                <Button
                    android:id="@+id/btnDiscard"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Verwerfen" />

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:text="Hinzufügen" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Seitenmenü mit allen Scan-Einstellungen -->
    <View
        android:id="@+id/menuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scanMenu"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="?attr/colorSurface"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scan-Einstellungen"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnMenuClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Schließen"
                    android:src="@drawable/ic_back" />
            </LinearLayout>

            <TextView
                style="@style/ScanMenuHeader"
                android:text="Ziel-Deck" />

            <Spinner
                android:id="@+id/deckSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/ScanMenuHint"
                android:text="Gescannte Karten kommen in die Sammlung und zusätzlich in dieses Deck." />

            <TextView
                style="@style/ScanMenuHeader"
                android:text="Kartensprache" />

            <Spinner
                android:id="@+id/langSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/ScanMenuHeader"
                android:text="Druck / Edition" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/codeMode"
                style="@style/ScanMenuSwitch"
                android:text="Nur unteren Rand scannen (Set-Code + Nummer)" />

            <TextView
                style="@style/ScanMenuHint"
                android:text="Genaueste Erkennung des Drucks: z.B. „0077“ und „FDN • DE“ in den Streifen halten. Für Karten ab ca. 2014." />

            <EditText
                android:id="@+id/fixedSet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Edition festlegen, z.B. FDN (leer = automatisch)"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="6" />

            <TextView
                style="@style/ScanMenuHint"
                android:text="Automatisch: Ist unten nichts lesbar, wird die zuletzt sicher erkannte Edition bevorzugt – praktisch für Stapel aus einer Edition." />

            <TextView
                style="@style/ScanMenuHeader"
                android:text="Hinzufügen" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoAdd"
                style="@style/ScanMenuSwitch"
                android:text="Automatisch hinzufügen (ohne Bestätigung)" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/batchMode"
                style="@style/ScanMenuSwitch"
                android:text="Stapel-Modus (erst sammeln, dann speichern)" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/proxyMode"
                style="@style/ScanMenuSwitch"
                android:text="Proxy (Tag „Proxies“)" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/foilDefault"
                style="@style/ScanMenuSwitch"
                android:text="Foil" />

            <TextView
                style="@style/ScanMenuHeader"
                android:text="Kamera &amp; Rückmeldung" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/landscapeMode"
                style="@style/ScanMenuSwitch"
                android:text="Querformat-Rahmen (z.B. Schlachten)" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/soundMode"
                style="@style/ScanMenuSwitch"
                android:text="Ton beim Scannen" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
